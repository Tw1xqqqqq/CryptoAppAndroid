<?xml version="1.0" encoding="utf-8"?>
<!-- Сливается с манифестом app при сборке -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Скачивание резюме -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Показ напоминания о паре: на Android 13+ пользователь выдаёт разрешение в диалоге -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Напоминание должно сработать точно в указанное время -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application>
        <receiver
            android:name="ru.urfu.cryptoapp.feature.profile.data.notification.LectureReminderReceiver"
            android:exported="false" />

        <!-- Доступ к снимку для приложения камеры и к резюме для просмотрщика -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Просит Google Play установить Photo Picker на Android 4.4-10, где его нет в системе -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data
                android:name="photopicker_activity:0:required"
                android:value="" />
        </service>
    </application>

</manifest>
